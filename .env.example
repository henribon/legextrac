# Provedor de traducao: gemini (padrao) ou deepl
TRANSLATOR=gemini

# --- Gemini (plano gratuito, sem cartao) ---------------------------------
# Chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=sua-chave-aqui
# Modelo. Veja os disponiveis com: python -m app.models_disponiveis
# GEMINI_MODEL=gemini-3.5-flash
# Alternativa com cota mais folgada: gemini-3.5-flash-lite
# Requisicoes por minuto do seu plano
# GEMINI_RPM=10
# GEMINI_MAX_ITEMS_PER_REQUEST=60
# GEMINI_MAX_CHARS_PER_REQUEST=6000
# Nivel de raciocinio: low (padrao). Vazio omite o campo.
# GEMINI_THINKING_LEVEL=low
# Modelo usado para DITAR o audio. Vazio = o mesmo GEMINI_MODEL.
# GEMINI_TRANSCRIBE_MODEL=
# Teto da resposta. Video longo vira texto longo; apertado demais, corta.
# GEMINI_MAX_OUTPUT_TOKENS=65536

# --- DeepL (alternativa) --------------------------------------------------
# Chave em https://www.deepl.com/pro-api
# Chaves gratuitas terminam com ":fx" e usam automaticamente api-free.deepl.com
# DEEPL_API_KEY=sua-chave-aqui
# DEEPL_API_URL=https://api-free.deepl.com/v2/translate

# Idioma de destino padrao
DEFAULT_TARGET_LANG=PT-BR

# Pasta onde os .txt sao gravados. Vazio = pasta Downloads do usuario.
# Relativo = a partir da raiz do projeto.
# OUTPUT_DIR=

# Opcional: proxy HTTP para buscar legendas
# (YouTube costuma bloquear IPs de datacenter/nuvem)
# YT_PROXY_HTTP=http://user:pass@host:porta
# YT_PROXY_HTTPS=http://user:pass@host:porta

# --- Midia (Instagram, TikTok, X, Facebook...) ----------------------------
# Esses sites nao publicam legenda: o programa baixa o video e manda o audio
# para o Gemini transcrever. Precisa da GEMINI_API_KEY acima, mesmo com
# TRANSLATOR=deepl.

# Video do YouTube sem legenda (ou IP limitado) tambem cai no audio.
# Ponha 0 para preferir falhar em vez de gastar cota do Gemini.
# AUDIO_FALLBACK=1

# Teto de duracao para transcricao por audio, em minutos.
# MEDIA_MAX_MINUTES=30

# Instagram e TikTok escondem boa parte do conteudo atras de login. Isto
# reaproveita a sessao ja aberta no navegador (chrome, edge, firefox, brave).
# Aceita "chrome:Profile 2" para escolher o perfil.
# COOKIES_FROM_BROWSER=chrome
# Alternativa: arquivo cookies.txt no formato Netscape (tem prioridade).
# COOKIES_FILE=
