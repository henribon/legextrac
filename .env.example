# Provedor de traducao: gemini (padrao) ou deepl
TRANSLATOR=gemini

# --- Gemini (plano gratuito, sem cartao) ---------------------------------
# Chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=sua-chave-aqui
# Modelo. Veja os disponiveis com: python -m app.models_disponiveis
# GEMINI_MODEL=gemini-3.5-flash
# Alternativa com cota mais folgada: gemini-3.5-flash-lite
# Requisicoes por minuto do seu plano
# GEMINI_RPM=10
# GEMINI_MAX_ITEMS_PER_REQUEST=60
# GEMINI_MAX_CHARS_PER_REQUEST=6000
# Nivel de raciocinio: low (padrao). Vazio omite o campo.
# GEMINI_THINKING_LEVEL=low

# --- DeepL (alternativa) --------------------------------------------------
# Chave em https://www.deepl.com/pro-api
# Chaves gratuitas terminam com ":fx" e usam automaticamente api-free.deepl.com
# DEEPL_API_KEY=sua-chave-aqui
# DEEPL_API_URL=https://api-free.deepl.com/v2/translate

# Idioma de destino padrao
DEFAULT_TARGET_LANG=PT-BR

# Pasta onde os .txt sao gravados. Vazio = pasta Downloads do usuario.
# Relativo = a partir da raiz do projeto.
# OUTPUT_DIR=

# Opcional: proxy HTTP para buscar legendas
# (YouTube costuma bloquear IPs de datacenter/nuvem)
# YT_PROXY_HTTP=http://user:pass@host:porta
# YT_PROXY_HTTPS=http://user:pass@host:porta
